import java.util.Scanner;

class Mainmatrix {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int m = sc.nextInt();

        int[][] matrix = new int[n][m];

        // Read matrix
        for (int r = 0; r < n; r++) {
            for (int c = 0; c < m; c++) {
                matrix[r][c] = sc.nextInt();
            }
        }

        int i = sc.nextInt();
        int j = sc.nextInt();

        // Swap columns i and j
        for (int r = 0; r < n; r++) {
            int temp = matrix[r][i];
            matrix[r][i] = matrix[r][j];
            matrix[r][j] = temp;
        }

        // Output matrix
        for (int r = 0; r < n; r++) {
            for (int c = 0; c < m; c++) {
                System.out.print(matrix[r][c] + " ");
            }
            System.out.println();
        }
    }
}
